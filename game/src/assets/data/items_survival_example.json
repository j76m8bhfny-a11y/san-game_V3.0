  "calculationNotes": {
    "description": "数值设计指南",
    "dimensionScale": {
      "0-20": "极差 - 生存受到严重威胁",
      "20-40": "较差 - 需要尽快改善",
      "40-60": "一般 - 勉强维持",
      "60-80": "良好 - 比较安全",
      "80-100": "优秀 - 几乎无忧"
    },
    "balancingTips": [
      "1. 食物类物品主要影响 nutritionSupply",
      "2. 住所和装备主要影响 physicalDefense", 
      "3. 舒适物品和信仰主要影响 mentalStability",
      "4. 医疗物品和保险主要影响 medicalSupport",
      "5. 金钱和收入主要影响 economicBuffer",
      "6. 调整物品价格来平衡获取难度",
      "7. 负面效果（成瘾、减san）可以作为强力物品的平衡代价"
    ],
