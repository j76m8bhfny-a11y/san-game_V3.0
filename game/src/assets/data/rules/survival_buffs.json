  "eventMappings": {
    "_comment": "原有事件映射",
    "EVT_01_BENCH": { "buffId": "shock_homelessness", "probability": 0.5 },
    "EVT_04_SPIKES": { "buffId": "shock_homelessness", "probability": 1.0 },
    "JOB_LOST": { "buffId": "shock_fired", "probability": 1.0 },
    "DISEASE_CONTRACTED": { "buffId": "shock_illness", "probability": 1.0 },
    
    "_comment": "新增：食物触发事件",
    "EVT_FOODPOISONING_MCNUGGET": { 
      "buffId": "shock_illness", 
      "probability": 1.0,
      "overrideDuration": 3
    },
    
    "_comment": "新增：医疗债务系统事件",
    "MEDICAL_DEBT_COLLECTIONS": {
      "buffId": "buff_medical_collection",
      "probability": 1.0
    },
    "BLACK_MARKET_MEDICAL_ONLY": {
      "buffId": "buff_black_market_medical",
      "probability": 1.0
    }
