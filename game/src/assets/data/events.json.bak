  {
    "id": "EVT_04_SPIKES",
    "title": "桥下尖刺",
    "bgImage": "/assets/scenes/bg_underbridge.png",
    "eventImage": "/assets/events/evt_concrete_spikes.png",
    "text": "下暴雨了，你跑到立交桥下避雨。发现原本干燥的空地上，密密麻麻铺满了尖锐的水泥锥子。",
    "conditions": {
      "requiredClass": [
        "HOMELESS"
      ],
      "minSan": 0,
      "maxSan": 100
    },
    "options": {
      "A": {
        "label": "现代工业风装置艺术",
        "roast": "你有艺术细菌，可惜没命欣赏。",
