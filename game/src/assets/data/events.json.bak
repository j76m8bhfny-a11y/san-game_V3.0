          "scaling": "LEVERAGE",
          "gold": 300,
          "hp": -3,
          "insightGain": 4
        }
      },
      "B": {
        "label": "大概是为了防老鼠",
        "roast": "没错，防的就是你这只两条腿的大老鼠。",
        "effects": {
          "scaling": "FIXED",
          "gold": 50,
          "hp": 2,
          "insightGain": 2
        }
      },
      "C": {
        "label": "消除火灾隐患和死角",
        "roast": "为了安全，把你弄死在雨里，这就很安全了。",
        "effects": {
          "scaling": "INCOME",
          "gold": -0.2,
          "hp": 8,
          "insightClear": 2
        }
      },
      "D": {
        "label": "连站都不让你站",
        "roast": "完全正确。城市不仅不让你睡，连让你“存在”都觉得碍眼。",
