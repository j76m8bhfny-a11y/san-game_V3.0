[
  {
    "id": "EVT_01_BENCH",
    "title": "公园长椅",
    "bgImage": "/assets/scenes/bg_park_snow.png",
    "eventImage": "/assets/events/evt_bench_spikes.png",
    "text": "暴雪夜，你冻得全身僵硬，想在公园长椅上躺会儿。走近一看，椅子中间焊死了几个金属扶手，根本躺不进去。",
    "conditions": {
      "requiredClass": [
        "HOMELESS"
      ],
      "minSan": 0,
      "maxSan": 100
    },
    "options": {
      "A": {
        "label": "拒绝葛优瘫，保持体面",
        "roast": "冻死事小，失节事大。你死得很有线条感。",
        "effects": {
          "scaling": "LEVERAGE",
          "gold": 300,
          "hp": -3,
          "insightGain": 4
        }
      },
      "B": {
        "label": "凑合坐会儿，别惹事",
        "roast": "真乖。你像条特别懂事的流浪狗，富人看了都说好。",
        "effects": {
          "scaling": "FIXED",
          "gold": 50,
          "hp": 2,
          "insightGain": 2
        }
      },
      "C": {
        "label": "防止霸座，公平共享",
        "roast": "饭都没得吃，还在替纳税人操心？顶级耗材。",
        "effects": {
          "scaling": "INCOME",
          "gold": -0.2,
          "hp": 8,
          "insightClear": 2
        }
      },
      "D": {
        "label": "混凝土做的驱逐武器",
        "roast": "人间清醒。可惜看穿了恶意也不能当被子盖，接着冻着吧。",
        "sanLock": 40,
        "isGlitched": true,
        "archiveId": "No.01_CAMDEN_BENCH",
        "effects": {
          "scaling": "INCOME",
          "gold": -0.4,
          "hp": -8,
          "insightClear": 10
        }
      }
    }
  },
  {
    "id": "EVT_02_TOILET",
    "title": "上锁的厕所",
    "bgImage": "/assets/scenes/bg_cafe_street.png",
    "eventImage": "/assets/events/evt_keypad_lock.png",
    "text": "你拉肚子快憋不住了，冲进路边的星巴克借厕所。店员冷冷指着密码锁：“密码在收据上，不买别用。” 你兜里只有两个钢镚。",
    "conditions": {
      "requiredClass": [
        "HOMELESS"
      ],
      "minSan": 0,
      "maxSan": 100
    },
    "options": {
      "A": {
        "label": "商业契约，付费天经地义",
        "roast": "拉裤兜里事小，失信事大。你虽然臭了，但灵魂是香的。",
        "effects": {
          "scaling": "LEVERAGE",
          "gold": 300,
          "hp": -3,
          "insightGain": 4
