  "visuals": {
    "description": "视觉效果阈值配置",
    "thresholds": {
      "hpLow": 30,
      "insightLow": 30,
      "insightMedium": 50,
      "insightHigh": 70,
      "insightAwaken": 85,
      "addictionHigh": 50
