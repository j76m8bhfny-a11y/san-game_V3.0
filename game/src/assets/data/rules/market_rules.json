{
  "$schema": "market-rules-config",
  "description": "加密货币交易系统配置，被MarketSystem使用",
  "version": "1.0.0",
  
  "crypto": {
    "description": "加密货币基础配置",
    "initialPrice": 15000,
    "accountFee": 500,
    "kyc": {
      "requiredLicense": true,
      "acceptedLicenses": ["LICENSE_FAKE", "LICENSE_VALID", "LICENSE_ELITE"]
    }
  },
  
  "trading": {
    "description": "交易规则配置",
    "leverage": {
      "presets": [2, 10, 20, 50, 100],
      "default": 10,
      "dangerThreshold": 50,
      "min": 1,
      "max": 100
    },
    "networkFee": 15,
    "maxTradesPerTurn": 1,
    "defaultAmount": 100,
    "liquidationThreshold": -1.0,
    "quickAmounts": [0.25, 0.5, 1.0]
  },
  
  "market": {
    "description": "市场波动配置",
    "baseVolatility": 0.15,
    "price": {
      "min": 500
    },
    "events": {
      "moonChance": 0.02,
      "doomChance": 0.02,
      "moonMultiplierBase": 0.5,
      "doomMultiplierBase": 0.4
    }
  },
  
  "ui": {
    "description": "UI显示配置",
    "header": {
      "networkStatus": "NET: UNSTABLE",
      "networkStatusColor": "#ef4444",
      "blinkInterval": 800
    },
    "marquee": {
      "gasFeeBase": 15,
      "gasFeeVariance": 5,
      "text": "GAS FEE: ${fee} | BLOCK #{block} | MEMPOOL CONGESTED"
    },
    "leverage": {
      "dangerColor": "#dc2626",
      "dangerLabel": "SUICIDE MODE",
      "dangerIcon": "💀"
    },
    "buttons": {
      "long": {
        "text": "PUMP IT",
        "subtext": "LONG",
        "icon": "🚀"
      },
      "short": {
        "text": "DUMP IT",
        "subtext": "SHORT",
        "icon": "📉"
      },
      "allIn": {
        "text": "ALL IN",
        "flavor": "破碎命运"
      }
    },
    "chart": {
      "paddingMin": 0.95,
      "paddingMax": 1.05
    },
    "ticker": {
      "defaultText": ">>> SYSTEM: WAITING FOR NETWORK CONNECTION... <<<",
      "speedSeconds": 20
    }
  },
  
  "news": {
    "description": "新闻弹窗配置",
    "popup": {
      "prefix": ">>> BREAKING:",
      "widthPercent": 70,
      "durationMs": 5000
    }
  }
}
