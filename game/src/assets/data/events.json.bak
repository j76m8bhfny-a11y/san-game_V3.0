      },
      "B": {
        "label": "快走吧，别惹麻烦",
        "roast": "跑得挺快。“怂”是你最好的护身符。",
        "effects": {
          "scaling": "FIXED",
          "gold": 50,
          "hp": 2,
          "insightGain": 2
        }
      },
      "C": {
        "label": "设门槛是为了防吸毒",
        "roast": "都在憋屎了还替老板操心？资本家就需要你这种自带干粮的保安。",
        "effects": {
          "scaling": "INCOME",
          "gold": -0.2,
          "hp": 8,
          "insightClear": 2
        }
      },
      "D": {
        "label": "针对穷人的过滤器",
